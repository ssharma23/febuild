{
 "datasets": [
  {
   "name": "ds_e03f8d43",
   "displayName": "Value bridge",
   "queryLines": [
    "SELECT round(100*auto_decision_rate_before,1) auto_before, round(100*auto_decision_rate_after,1) auto_after,\n",
    "  round(median_decision_minutes_before/60,1) median_hours_before, round(median_decision_minutes_after,1) median_minutes_after,\n",
    "  round(100*pull_through_lift_did,1) pull_through_lift_pts, round(100*epd_change_did,2) epd_change_pts,\n",
    "  round((value_pull_through_nii+value_underwriter_capacity+value_epd_losses_avoided+value_declines_recovered_nii)*scale_to_reference_cu/1e6,2) value_ref_cu_mm,\n",
    "  round((value_pull_through_nii+value_underwriter_capacity+value_epd_losses_avoided+value_declines_recovered_nii)/1e6,2) value_pilot_mm,\n",
    "  extra_funded_loans_yr, underwriter_hours_saved_yr, declines_recovered_yr\n",
    "FROM demo_dnb_catalog.ml_lend_semantic.v_value_bridge"
   ]
  },
  {
   "name": "ds_ddfde2d8",
   "displayName": "Value components (reference CU)",
   "queryLines": [
    "SELECT * FROM (SELECT stack(4,\n",
    "  '1 \u00b7 Faster decisions \u2192 more funded loans', round(CAST(value_pull_through_nii AS DOUBLE)*scale_to_reference_cu),\n",
    "  '2 \u00b7 Underwriter capacity released', round(CAST(value_underwriter_capacity AS DOUBLE)*scale_to_reference_cu),\n",
    "  '3 \u00b7 Early-default losses avoided (AI income check)', round(CAST(value_epd_losses_avoided AS DOUBLE)*scale_to_reference_cu),\n",
    "  '4 \u00b7 Declines turned into funded loans', round(CAST(value_declines_recovered_nii AS DOUBLE)*scale_to_reference_cu)) AS (value_lever, annual_value_usd)\n",
    "FROM demo_dnb_catalog.ml_lend_semantic.v_value_bridge)"
   ]
  },
  {
   "name": "ds_267fb3dd",
   "displayName": "Pilot vs control",
   "queryLines": [
    "SELECT cohort, period, MEASURE(applications) applications, round(100*MEASURE(approval_rate),1) approval_rate_pct,\n",
    "  round(100*MEASURE(pull_through_rate),1) pull_through_pct, round(MEASURE(funded_amount)/1e6,1) funded_mm\n",
    "FROM demo_dnb_catalog.ml_lend_semantic.mv_loan_funnel GROUP BY ALL ORDER BY cohort DESC, period DESC"
   ]
  },
  {
   "name": "ds_e7b6bebf",
   "displayName": "Pilot vs control speed",
   "queryLines": [
    "SELECT cohort, period, round(100*MEASURE(auto_decision_rate),1) auto_decision_pct,\n",
    "  MEASURE(median_decision_minutes) median_minutes, round(100*MEASURE(decided_within_24h_rate),1) within_24h_pct\n",
    "FROM demo_dnb_catalog.ml_lend_semantic.mv_decision_speed GROUP BY ALL ORDER BY cohort DESC, period DESC"
   ]
  },
  {
   "name": "ds_a69d2fb8",
   "displayName": "Monthly pull-through",
   "queryLines": [
    "SELECT submitted_month, cohort, round(100*MEASURE(pull_through_rate),1) pull_through_pct\n",
    "FROM demo_dnb_catalog.ml_lend_semantic.mv_loan_funnel WHERE submitted_month < '2026-11-01' GROUP BY ALL"
   ]
  },
  {
   "name": "ds_0ee69d9b",
   "displayName": "Monthly median decision time",
   "queryLines": [
    "SELECT submitted_month, cohort, round(MEASURE(median_decision_minutes)/60,2) median_hours,\n",
    "  round(100*MEASURE(auto_decision_rate),1) auto_decision_pct FROM demo_dnb_catalog.ml_lend_semantic.mv_decision_speed GROUP BY ALL"
   ]
  },
  {
   "name": "ds_0807e26b",
   "displayName": "24-hour cliff",
   "queryLines": [
    "SELECT CASE WHEN decision_minutes <= 60 THEN '1 \u00b7 under 1 hour' WHEN decision_minutes <= 240 THEN '2 \u00b7 1-4 hours'\n",
    "  WHEN decision_minutes <= 1440 THEN '3 \u00b7 4-24 hours' ELSE '4 \u00b7 over 24 hours' END decision_time,\n",
    "  round(100*avg(CASE WHEN is_funded THEN 1.0 ELSE 0 END),1) pull_through_pct, count(*) approved\n",
    "FROM demo_dnb_catalog.ml_lend_gold.fact_application WHERE is_approved GROUP BY 1"
   ]
  },
  {
   "name": "ds_35f4f63e",
   "displayName": "Decision engine mix (pilot)",
   "queryLines": [
    "SELECT submitted_month, decision_engine, MEASURE(decided_applications) decisions\n",
    "FROM demo_dnb_catalog.ml_lend_semantic.mv_decision_speed WHERE cohort = 'PILOT' GROUP BY ALL"
   ]
  },
  {
   "name": "ds_807a3c3e",
   "displayName": "Channel lift (pilot)",
   "queryLines": [
    "SELECT channel, period, round(100*MEASURE(pull_through_rate),1) pull_through_pct\n",
    "FROM demo_dnb_catalog.ml_lend_semantic.mv_loan_funnel WHERE cohort = 'PILOT' GROUP BY ALL"
   ]
  },
  {
   "name": "ds_55fd8fef",
   "displayName": "EPD by cohort",
   "queryLines": [
    "SELECT concat(cohort, ' \u00b7 ', period) cohort_period, cohort, period, round(100*MEASURE(epd_rate),2) epd_pct, MEASURE(seasoned_loans) seasoned\n",
    "FROM demo_dnb_catalog.ml_lend_semantic.mv_portfolio_risk GROUP BY ALL"
   ]
  },
  {
   "name": "ds_14fbc8e9",
   "displayName": "AI income verification",
   "queryLines": [
    "SELECT date_trunc('WEEK', submitted_ts) week, count(*) documents_verified,\n",
    "  sum(CASE WHEN ai_income_mismatch_flag THEN 1 ELSE 0 END) mismatches FROM demo_dnb_catalog.ml_lend_gold.fact_application WHERE ai_verified_monthly_income IS NOT NULL GROUP BY 1"
   ]
  },
  {
   "name": "ds_5240ecea",
   "displayName": "Model risk bands",
   "queryLines": [
    "SELECT risk_band, count(*) applications, round(100*avg(epd_probability),2) avg_epd_pct FROM demo_dnb_catalog.ml_lend_ml.application_risk_scores GROUP BY 1"
   ]
  },
  {
   "name": "ds_c745a717",
   "displayName": "AI note categories",
   "queryLines": [
    "SELECT note_category, count(*) notes FROM demo_dnb_catalog.ml_lend_gold.member_notes_enriched WHERE note_category IS NOT NULL GROUP BY 1"
   ]
  },
  {
   "name": "ds_aeef8878",
   "displayName": "Expectations",
   "queryLines": [
    "WITH exp AS (\n",
    "  SELECT e.name expectation, e.dataset dataset, coalesce(e.passed_records,0) passed, coalesce(e.failed_records,0) failed\n",
    "  FROM event_log('98881b13-1625-4b3d-810c-ad987acd8c9e'), LATERAL explode(from_json(details:flow_progress:data_quality:expectations,\n",
    "       'array<struct<name:string,dataset:string,passed_records:bigint,failed_records:bigint>>')) t(e)\n",
    "  WHERE event_type = 'flow_progress' AND details:flow_progress:data_quality:expectations IS NOT NULL)\n",
    "SELECT expectation, sum(passed) passed_records, sum(failed) failed_records,\n",
    "  round(100*sum(passed)/nullif(sum(passed+failed),0),3) pass_rate_pct FROM exp GROUP BY expectation"
   ]
  },
  {
   "name": "ds_b736729b",
   "displayName": "Quarantine",
   "queryLines": [
    "SELECT 'applications' entity, failed_rule, count(*) records FROM demo_dnb_catalog.ml_lend_silver.applications_quarantine GROUP BY ALL\n",
    "UNION ALL SELECT 'members', failed_rule, count(*) FROM demo_dnb_catalog.ml_lend_silver.members_quarantine GROUP BY ALL"
   ]
  },
  {
   "name": "ds_ffdc2d30",
   "displayName": "Governed columns",
   "queryLines": [
    "SELECT schema_name || '.' || table_name tbl, column_name, tag_name, coalesce(tag_value,'') tag_value\n",
    "FROM demo_dnb_catalog.information_schema.column_tags WHERE schema_name LIKE 'ml_lend%' AND (tag_name LIKE 'class.%' OR tag_name = 'tenant_isolation_key')"
   ]
  }
 ],
